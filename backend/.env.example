# =========================================================================
# DevTrackr - Backend Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# -------------------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------------------
# The port number on which the Express server will listen.
PORT=5000

# The running mode of the Node application (development, staging, or production).
NODE_ENV=development

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------
# MongoDB connection URI. Replace placeholders with MongoDB Atlas cluster 
# credentials or supply a local MongoDB connection string (e.g. mongodb://localhost:27017/devtrackr).
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/devtrackr

# -------------------------------------------------------------------------
# JSON Web Token (JWT) Security Configuration
# -------------------------------------------------------------------------
# Secret key used to sign authorization tokens. Choose a long, randomized, secure passphrase.
JWT_SECRET=your_jwt_secret_key_here_must_be_long_and_secure

# Token expiration duration (e.g., 24h, 7d, 30d). Matches standard ms format.
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------------
# Gemini AI Configuration
# -------------------------------------------------------------------------
# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/).
# Used for compiling telemetric developer productivity insights and sprint diagnostic summaries.
GEMINI_API_KEY=your_google_gemini_api_key_here

# -------------------------------------------------------------------------
# GitHub Integration & OAuth Credentials
# -------------------------------------------------------------------------
# Client ID of your GitHub OAuth Application, registered via GitHub Developer Settings.
GITHUB_CLIENT_ID=your_github_client_id

# Client Secret of your GitHub OAuth Application. KEEP THIS SECURE.
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth Callback redirect URL. Must match the callback URL registered in the GitHub Developer Console.
# Default callback is processed by the frontend dashboard callback route.
GITHUB_CALLBACK_URL=http://localhost:5173/github/callback

# -------------------------------------------------------------------------
# CORS & Networking Policy
# -------------------------------------------------------------------------
# URL of the React client application allowed to establish connections to the REST API.
FRONTEND_URL=http://localhost:5173
