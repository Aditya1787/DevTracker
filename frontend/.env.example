# =========================================================================
# DevTrackr - Frontend Environment Variables Template
# Copy this file to '.env' and populate with matching values.
# =========================================================================

# -------------------------------------------------------------------------
# API Services
# -------------------------------------------------------------------------
# Base URL for the DevTrackr backend Express server REST API endpoints.
VITE_API_URL=http://localhost:5000/api

# -------------------------------------------------------------------------
# GitHub OAuth Credentials
# -------------------------------------------------------------------------
# Client ID of your GitHub OAuth Application, registered via GitHub Developer Settings.
# Must match the GITHUB_CLIENT_ID configured on the backend server.
VITE_GITHUB_CLIENT_ID=your_github_client_id
